# Public Firebase web registration (bundled into the browser; never put admin,
# service-account, payment-provider, JWT, or AI secrets in VITE_* variables).
# Restrict this API key to the required Firebase APIs and approved web origins.
# The first four variables below are required for every production build.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Local development only. A production build fails if this is true.
VITE_USE_FIREBASE_EMULATORS=false
# Optional overrides when the default local emulator ports are occupied.
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
