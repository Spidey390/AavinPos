{
  "name": "aavin-pos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:functions && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:functions && npm run test:rules",
    "deploy": "node scripts/deploy-guidance.js",
    "deploy:all": "node scripts/deploy-guidance.js",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "node --test tests/domain.test.js tests/deployment.test.js",
    "test:rules": "node scripts/test-rules.js",
    "check:secrets": "node scripts/check-secrets.js",
    "verify": "npm run lint && npm test && npm run build && npm audit && npm --prefix functions audit && npm run check:secrets",
    "build:functions": "npm --prefix functions run build",
    "test:functions": "npm --prefix functions test",
    "start": "node --env-file-if-exists=server.env functions/src/server.js",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.3.0",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "engines": {
    "node": ">=24"
  }
}
